# Copy to .env (gitignored) — Bun auto-loads it.
# Atlas connection string; the database name comes from the path.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>/promptlib?retryWrites=true&w=majority"

# Optional: port for the API + console (default 3000)
# PORT=3000

# Optional: database name if your URI path differs (default promptlib)
# PROMPTLIB_DB=promptlib

# Optional: role API keys for RBAC. Set any to require keys; omit all to
# run in open demo mode (no keys required, every action allowed).
# PROMPTLIB_ADMIN_KEY=...     — everything: publish, rollback, split, seed
# PROMPTLIB_EDITOR_KEY=...    — create versions, submit, overlays, few-shots
# PROMPTLIB_REVIEWER_KEY=...  — approve / reject versions in review

# LLM gateway (OpenAI-compatible) used by runs, evals, and the judge.
# Defaults: OpenAI-compatible /v1, model deepseek-v4-flash-0731.
# LLM_BASE_URL=...
# LLM_API_KEY=...
# LLM_MODEL=...
